{
  "version": 1,
  "actions": {
    "timmy-workspace": {
      "type": "workspaceCommand",
      "title": "TIMMY Workspace",
      "subtitle": "Open TUI, evidence doctor, and edge health",
      "commandName": "TIMMY Workspace",
      "icon": { "type": "symbol", "name": "rectangle.split.2x2" },
      "palette": true
    }
  },
  "ui": {
    "newWorkspace": {
      "action": "timmy-workspace",
      "contextMenu": [
        { "action": "timmy-workspace", "title": "TIMMY Workspace" },
        { "type": "separator" },
        { "action": "cmux.newTerminal", "title": "New Terminal" },
        { "action": "cmux.newBrowser", "title": "New Browser" }
      ]
    },
    "surfaceTabBar": {
      "buttons": [
        "cmux.newTerminal",
        "cmux.newBrowser",
        "cmux.splitRight",
        "cmux.splitDown",
        {
          "action": "timmy-workspace",
          "title": "TIMMY Workspace",
          "icon": { "type": "symbol", "name": "rectangle.split.2x2" }
        }
      ]
    }
  },
  "commands": [
    {
      "name": "TIMMY Workspace",
      "description": "Launch a clean TIMMY operator workspace with the TUI, local evidence status, and Cloudflare edge health.",
      "workspace": {
        "name": "TIMMY Workspace",
        "cwd": ".",
        "layout": {
          "direction": "horizontal",
          "children": [
            {
              "pane": {
                "surfaces": [
                  {
                    "type": "terminal",
                    "name": "TIMMY TUI",
                    "command": "npm start"
                  }
                ]
              }
            },
            {
              "direction": "vertical",
              "children": [
                {
                  "pane": {
                    "surfaces": [
                      {
                        "type": "terminal",
                        "name": "Evidence Doctor",
                        "command": "npx tsx scripts/timmy-doctor.ts doctor; printf \"\\nEvidence labels complete. Press Ctrl+D to close or keep working here.\\n\"; exec \"$SHELL\" -l"
                      }
                    ]
                  }
                },
                {
                  "pane": {
                    "surfaces": [
                      {
                        "type": "browser",
                        "name": "Edge Health",
                        "url": "https://<hostname>/health"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "custom_commands": [
    {
      "id": "timmy-tui-start",
      "shortcut": "cmd+shift+t",
      "command": "npm start",
      "label": "Start TIMMY TUI OS",
      "cwd": "workspace"
    },
    {
      "id": "timmy-tui-build",
      "shortcut": "cmd+shift+b",
      "command": "npm run build",
      "label": "Build TIMMY TypeScript",
      "cwd": "workspace"
    },
    {
      "id": "timmy-tui-doctor",
      "shortcut": "cmd+shift+d",
      "command": "npx tsx scripts/timmy-doctor.ts doctor",
      "label": "Run TIMMY Diagnosis",
      "cwd": "workspace"
    },
    {
      "id": "timmy-tui-security",
      "shortcut": "cmd+shift+s",
      "command": "scripts/security-scan.sh",
      "label": "Run Security Secret Scan",
      "cwd": "workspace"
    }
  ]
}
