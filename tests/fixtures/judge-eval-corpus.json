    {
      "id": "clean-pass-high-confidence",
      "class": "known_good",
      "facets": ["adherence", "coherence"],
      "threshold": 0.7,
      "local_verdicts": [
        { "scores": { "adherence": 9, "coherence": 8 }, "confidence": 0.9, "critique": "" }
      ],
      "expected": { "final_pass": true, "escalated": false }
    },
    {
      "id": "low-score-clean-confidence",
      "class": "known_bad",
      "facets": ["adherence"],
