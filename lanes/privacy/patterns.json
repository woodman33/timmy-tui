{
 "v": 1,
 "$comment": "The Timmy privacy pattern set (ORDER privacy-d5n9). Every pattern is a JS regex (flags per entry). severity: critical = a secret; high = personal data; medium = site-specific network/host identity; review = material that must stay out of the public tree unless it is already on the public pitch site. `allow` lists regexes for lines that are NOT findings (placeholders, examples, the seal of this very audit).",
 "patterns": [
  {
   "id": "secret.openrouter_key",
   "severity": "critical",
   "re": "sk-or-v1-[A-Za-z0-9]{20,}",
   "note": "OpenRouter API key"
  },
  {
   "id": "secret.openai_key",
   "severity": "critical",
   "re": "\\bsk-[A-Za-z0-9]{20,}\\b",
   "note": "OpenAI-style key"
  },
  {
   "id": "secret.anthropic_key",
   "severity": "critical",
   "re": "sk-ant-[A-Za-z0-9_-]{20,}",
   "note": "Anthropic key"
  },
  {
   "id": "secret.hf_token",
   "severity": "critical",
   "re": "\\bhf_[A-Za-z0-9]{20,}\\b",
   "note": "Hugging Face token"
  },
  {
   "id": "secret.github_token",
   "severity": "critical",
   "re": "\\b(gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{40,})\\b",
   "note": "GitHub token"
  },
  {
   "id": "secret.cloudflare_token",
   "severity": "critical",
   "re": "\\b(cf|cloudflare)[_-]?(api[_-]?)?token[^\\n]{0,10}[=:]\\s*['\\\"]?[A-Za-z0-9_-]{30,}",
   "flags": "i",
   "note": "Cloudflare API token assignment"
  },
  {
   "id": "secret.tailscale_key",
   "severity": "critical",
   "re": "\\btskey-(auth|api|client|oauth)-[A-Za-z0-9-]{10,}",
   "note": "Tailscale key"
  },
  {
   "id": "secret.aws_key",
   "severity": "critical",
   "re": "\\b(AKIA|ASIA)[0-9A-Z]{16}\\b",
   "note": "AWS access key id"
  },
  {
   "id": "secret.private_key_block",
   "severity": "critical",
   "re": "-----BEGIN (RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY",
   "note": "private key material"
  },
  {
   "id": "secret.jwt",
   "severity": "critical",
   "re": "\\beyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\b",
   "note": "JSON Web Token"
  },
  {
   "id": "secret.env_assignment",
   "severity": "critical",
   "re": "^\\s*(export\\s+)?[A-Z][A-Z0-9_]*(KEY|TOKEN|SECRET|PASSWORD|PASSWD)\\s*=\\s*['\\\"]?[A-Za-z0-9+/=_.-]{16,}",
   "flags": "m",
   "note": "a real value assigned to a *_KEY / *_TOKEN / *_SECRET name (not a placeholder)"
  },
  {
   "id": "secret.hold_token",
   "severity": "critical",
   "re": "\\bhold_[0-9a-f]{48}\\b",
   "note": "commander hold token (travels once, never stored)"
  },
  {
   "id": "secret.dev_vars_content",
   "severity": "critical",
   "re": "^TIMMY_EDGE_TOKEN\\s*=\\s*\\S{8,}",
   "flags": "m",
   "note": ".dev.vars content"
  },
  {
   "id": "pii.email",
   "severity": "high",
   "re": "\\b[A-Za-z0-9._%+-]+@(?!example\\.(?:com|org|net)\\b)(?!users\\.noreply\\.github\\.com\\b)(?![A-Za-z0-9.-]*\\.local\\b)[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b",
   "note": "email address (example.*, github noreply, and *.local excluded)"
  },
  {
   "id": "pii.phone",
   "severity": "high",
   "re": "(?<![0-9A-Za-z_./-])(\\+1[ .-]?)?\\(?[2-9][0-9]{2}\\)?[ .-][2-9][0-9]{2}[ .-][0-9]{4}(?![0-9A-Za-z_])",
   "note": "US phone number"
  },
  {
   "id": "pii.home_path",
   "severity": "high",
   "re": "/Users/[A-Za-z][A-Za-z0-9._-]*|/home/(?!user\\b|runner\\b|node\\b|ubuntu\\b)[A-Za-z][A-Za-z0-9._-]*",
   "note": "absolute home path (macOS/Linux); ~/ is generic, not flagged"
  },
  {
   "id": "pii.login_name",
   "severity": "high",
   "re": "\\b(williammeldman|wmeldman)\\b",
   "flags": "i",
   "note": "login name (williammeldman/wmeldman); wmeldman33 is the kept worker-subdomain handle"
  },
  {
   "id": "pii.person_name",
   "severity": "review",
   "re": "\\b(Will|William)\\s+Meldman\\b",
   "note": "founder name \u2014 authorship (LICENSE, package.json, attribution); review, not blocking"
  },
  {
   "id": "net.tailnet_ip",
   "severity": "medium",
   "re": "\\b100\\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\\.[0-9]{1,3}\\.[0-9]{1,3}\\b",
   "note": "Tailscale CGNAT IP (100.64/10)"
  },
  {
   "id": "net.tailnet_ip6",
   "severity": "medium",
   "re": "\\bfd7a:115c:a1e0:[0-9a-f:]+",
   "flags": "i",
   "note": "Tailscale IPv6"
  },
  {
   "id": "net.tailnet_name",
   "severity": "medium",
   "re": "\\btail[0-9a-f]{6}\\.ts\\.net\\b|\\btail3d1e15\\b",
   "note": "tailnet MagicDNS suffix"
  },
  {
   "id": "net.lan_ip",
   "severity": "medium",
   "re": "\\b192\\.168\\.[0-9]{1,3}\\.[0-9]{1,3}\\b|\\b10\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\b|\\b172\\.(1[6-9]|2[0-9]|3[01])\\.[0-9]{1,3}\\.[0-9]{1,3}\\b",
   "note": "LAN IP (RFC 1918)"
  },
  {
   "id": "net.mac",
   "severity": "medium",
   "re": "\\b([0-9a-f]{2}:){5}[0-9a-f]{2}\\b",
   "flags": "i",
   "note": "MAC address"
  },
  {
   "id": "net.mac_nvidia_oui",
   "severity": "medium",
   "re": "\\b4c:bb:47\\b",
   "flags": "i",
   "note": "NVIDIA OUI (the Sparks)"
  },
  {
   "id": "net.hostname_spark",
   "severity": "medium",
   "re": "\\bspark-[0-9a-f]{4}(-kvm)?\\b",
   "note": "DGX Spark hostname"
  },
  {
   "id": "net.hostname_mac",
   "severity": "medium",
   "re": "[Ww]illiam['\u2019]?s[- ]?[Mm]ac[Bb]ook[- ]?[Pp]ro(-2|\\s\\(2\\))?|williams-macbook-pro(-2|-exit-node)?",
   "note": "the Mac's hostname"
  },
  {
   "id": "net.other_hosts",
   "severity": "medium",
   "re": "\\b(nas-210|jetson-orin|minisforum-64gb|5080-msi|nvsync-[a-z0-9-]+)\\b",
   "note": "other tailnet machine names (command-center dropped: too generic a phrase)"
  },
  {
   "id": "net.worker_subdomain",
   "severity": "review",
   "re": "wmeldman33\\.workers\\.dev",
   "note": "Cloudflare account subdomain in worker URLs \u2014 KEPT by operator decision (privacy-d5n9): a live URL; downgraded to review"
  },
  {
   "id": "net.tailscale_policy",
   "severity": "medium",
   "re": "\"(ssh|grants|acls|tagOwners)\"\\s*:\\s*\\[|autogroup:(nonroot|self|member)",
   "note": "Tailscale policy text"
  },
  {
   "id": "custody.card_serial",
   "severity": "high",
   "re": "\\b(?:VC|TV|SUN)[A-Z0-9]{4,}(?:-[A-Z0-9]{2,})*\\b",
   "note": "card serial shape (VC0007 / VC0007-17-03 style)"
  },
  {
   "id": "custody.ntag_uid",
   "severity": "review",
   "re": "\\b04[0-9A-F]{12}\\b",
   "note": "NTAG 7-byte UID; the ones in vault-custody/test are synthetic SUN vectors \u2014 review, not blocking"
  },
  {
   "id": "brand.discovery_land",
   "severity": "review",
   "re": "Discovery\\s+Land",
   "flags": "i",
   "note": "material beyond the public pitch site"
  },
  {
   "id": "brand.raiders",
   "severity": "review",
   "re": "\\bRaiders\\b",
   "note": "material beyond the public pitch site"
  },
  {
   "id": "brand.paradise",
   "severity": "review",
   "re": "\\bParadise\\b",
   "note": "material beyond the public pitch site"
  },
  {
   "id": "media.personal",
   "severity": "review",
   "re": "\\.(heic|HEIC)$|IMG_[0-9]{4}|family|personal[_-]?(photo|video)",
   "note": "personal media names"
  }
 ],
 "allow": [
  "example\\.com",
  "\\{\\{[A-Z_]+\\}\\}",
  "<(tailnet|lan)-ip>|<hostname>|<user>|<node-id>|<mac>",
  "\\b(?:VC|TV|SUN)0000(?:-[A-Z0-9]{2,})*\\b",
  "REDACTED|\\[redacted\\]|xxxx|placeholder",
  "privacy\\.(audit|scan)",
  "lanes/privacy/(patterns\\.json|overlay\\.mjs)",
  "$comment",
  "your[_-]?key[_-]?here|your_[a-z_]*_(api_)?key_here|<your-[a-z-]+>|YOUR_[A-Z_]+_HERE",
  "not-valid|test-[a-z-]*-key|sk-or-v1-abcdef1234567890|sk-proj-abc123\\.\\.\\.|example-key|dummy-key",
  "your[-_][A-Za-z0-9]+[-_](api[-_])?(key|token|secret)[-_]here|your[-_][A-Za-z0-9-]*[-_]here",
  "isLocalIp\\(",
  "@[A-Za-z0-9.-]+\\.local\\b"
 ],
 "ignore_paths": [
  "node_modules/",
  "package-lock.json",
  "pnpm-lock.yaml",
  "yarn.lock",
  ".cache/",
  "dist/",
  "\\.(mp4|webm|mov|gif|png|jpg|jpeg|pdf|docx|woff2?|ttf|riv)$",
  "lanes/privacy/fixtures/",
  "lanes/privacy/patterns\\.json",
  "worker-configuration\\.d\\.ts$",
  "\\.timmy/store-pin$",
  "lanes/privacy/sanitize\\.mjs$"
 ]
}
