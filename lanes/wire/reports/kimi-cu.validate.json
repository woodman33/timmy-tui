            "name": "click"
          },
          {
            "description": "Type Unicode text into an app. Requires app or pid. Pass index (snapshot index) or x,y (screenshot pixels) to target an input. Omit index/x,y to inject into the target app's current focus. Cursor-safe; background. Use clear+submit to replace-and-send in one call. Some Electron inputs expose no AX text readback; in that case a completed delivery returns ok:true, verified:false, verification_required:\"screenshot\". Call get_app_state and inspect the screenshot before claiming success.",
            "inputSchema": {
              "properties": {
                "activate": {
                  "description": "FALLBACK ONLY — avoid unless needed. When the target window is fully covered by other windows, macOS defers the keys and nothing lands. Setting this briefly raises the window (a visible flash) to flush the input. Default false = pure background, never raises. Try a normal type_text (and set_value) first; only set activate:true if the result had occluded:true and the text did not land.",
                  "type": "boolean"
                },
                "app": {
                  "type": "string"
                },
                "clear": {
                  "description": "select-all + delete first, replacing the field's contents instead of appending at the cursor",
                  "type": "boolean"
                },
                "index": {
                  "description": "snapshot index (from get_app_state) to click-focus before typing",
                  "type": "integer"
                },
                "pid": {
                  "type": "integer"
                },
                "submit": {
                  "description": "press Return after typing (submits single-line fields like search/address bars; inserts a newline in multi-line editors). For targeted inputs (index or x,y), typed text is readback-verified before Return is sent; post-submit side effects are not verified because successful submit often clears or changes the field.",
                  "type": "boolean"
                },
                "text": {
                  "type": "string"
                },
                "x": {
                  "description": "screenshot pixel x to click-focus before typing (with y)",
                  "type": "number"
                },
                "y": {
                  "description": "screenshot pixel y to click-focus before typing (with x)",
                  "type": "number"
                }
