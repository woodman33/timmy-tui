{
 "kind": "blueprint",
 "name": "Cocos Creator · asset-pack",
 "source": "lanes/engines/cocos/templates/asset-pack/plan.cue",
 "date": "2026-09-07",
 "engine": "cocos",
 "workflow": "asset-pack",
 "proven": false,
 "note": "AUTHORED, UNPROVEN: no Cocos Creator on this Mac. The build config file (configPath) with buildBundleOnly is the documented way to pack Asset Bundles without a full player build; proven once a runner with the editor executes it through a drop folder.",
 "sheets": [
  { "id": "inputs", "title": "Inputs · drop/", "rows": [
   { "label": "project", "value": "*.cocos.zip", "note": "rules: run" },
   { "label": "assets", "value": "*.png · *.jpg · *.mp3 · *.ogg", "note": "rules: stage" },
   { "label": "refused", "value": "> 1 GB", "note": "rules: refuse → engine.refuse" }
  ] },
  { "id": "steps", "title": "Steps", "rows": [
   { "label": "1 unpack", "value": "unzip -q -o <zip> -d out/project", "note": "" },
   { "label": "2 pack", "value": "CocosCreator --project out/project --build \"configPath=<template>/bundle.json;buildPath=out/build\"", "note": "bundle.json: web-mobile, buildBundleOnly" }
  ] },
  { "id": "outputs", "title": "Outputs · out/", "rows": [
   { "label": "bundles", "value": "build/web-mobile/assets/<bundle>/", "note": "config.<hash>.json + import/ + native/" },
   { "label": "log", "value": "pack.log", "note": "the lane's step log" }
  ] },
  { "id": "receipt", "title": "Receipt · engine.run", "rows": [
   { "label": "cites", "value": "project sha256 · bundle files sha256 · env-lock", "note": "" }
  ] },
  { "id": "sources", "title": "Sources", "rows": [
   { "label": "publish CLI", "value": "https://docs.cocos.com/creator/3.8/manual/en/editor/publish/publish-in-command-line.html", "note": "configPath, buildPath" },
   { "label": "asset bundles", "value": "https://docs.cocos.com/creator/3.8/manual/en/asset/bundle.html", "note": "bundle folders, buildBundleOnly" }
  ] }
 ]
}
