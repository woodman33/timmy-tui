    },
    {
     "label": "2 start",
     "value": "bridge.mjs start: tools/call <start task>",
     "note": "{stem}.task.json with the task id"
    },
    {
     "label": "3 report",
     "value": "bridge.mjs report",
     "note": "{stem}.runable.json"
    }
   ]
  },
  {
   "id": "outputs",
