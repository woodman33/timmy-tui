     "value": "{stem}.tools.json",
     "note": "names + input keys, hashed"
    },
    {
     "label": "task",
     "value": "{stem}.task.json",
     "note": "task id, status, request ids"
    },
    {
     "label": "report",
     "value": "{stem}.runable.json",
     "note": ""
    }
   ]
  },
  {
   "id": "receipt",
   "title": "Receipt · engine.run",
   "rows": [
    {
