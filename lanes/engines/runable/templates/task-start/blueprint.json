     "note": "prompt · mode · model · predict{}"
    }
   ]
  },
  {
   "id": "steps",
   "title": "Steps",
   "rows": [
    {
     "label": "1 predict",
     "value": "bridge.mjs predict: tools/list snapshot, choose start/progress/files tools by name, seal the expected deliverable",
