{
 "kind": "blueprint",
 "name": "Runable · task-poll",
 "source": "lanes/engines/runable/templates/task-poll/plan.cue",
 "date": "2026-10-04",
 "engine": "runable",
 "workflow": "task-poll",
 "note": "Polling is the async half of a webhook-less service. Every answer is logged and hashed; the cap turns a stuck task into an honest timed_out receipt.",
 "sheets": [
  {
   "id": "inputs",
   "title": "Inputs · drop/",
   "rows": [
    {
     "label": "request",
     "value": "*.poll.json",
     "note": "task_id · max_minutes · every_seconds"
    }
   ]
  },
  {
   "id": "steps",
   "title": "Steps",
   "rows": [
    {
     "label": "1 poll",
     "value": "bridge.mjs poll: tools/call <progress> every N s until done/failed/cap",
     "note": "{stem}.progress.jsonl · {stem}.final.json"
    },
    {
     "label": "2 report",
     "value": "bridge.mjs report: minutes vs predicted",
     "note": "{stem}.runable.json"
    }
   ]
  },
  {
   "id": "outputs",
   "title": "Outputs · out/",
   "rows": [
    {
     "label": "progress",
     "value": "{stem}.progress.jsonl",
     "note": "one line per poll, each hashed"
    },
    {
     "label": "final",
     "value": "{stem}.final.json",
     "note": "status · polls · minutes"
    },
    {
     "label": "report",
     "value": "{stem}.runable.json",
     "note": ""
    }
   ]
  },
  {
   "id": "receipt",
   "title": "Receipt · engine.run",
   "rows": [
    {
     "label": "extra",
     "value": "status · task_id · task_status · polls · minutes · predicted_minutes · minutes_error_pct",
     "note": ""
    }
   ]
  }
 ]
}
