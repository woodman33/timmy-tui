{
  "name": "timmy-ai-proxy",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "TIMMY edge proxy: OpenRouter passthrough with spend guards, plus Code Mode — one generated script per agent task against every edge tool, sealed as a receipt.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler deploy --name timmy-ai-proxy-preview",
    "secret:preview": "wrangler secret put",
    "delete:preview": "wrangler delete --name timmy-ai-proxy-preview --force",
    "dev:local": "wrangler dev --port 8799",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudflare/codemode": "^0.5.1",
    "agents": "^0.22.0",
    "ai": "^7.0.93",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.129.0"
  }
}
